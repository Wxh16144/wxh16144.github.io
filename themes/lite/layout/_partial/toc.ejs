<%
  const toc = page_toc(page)
%>
<% if (toc.length) { %>
<nav class="page-toc" id="page-toc" aria-label="目录">
  <div class="toc-list">
    <% toc.forEach(function (item) { %>
      <a class="toc-lv-<%= item.level %>" href="#<%= item.id %>" data-target="<%= item.id %>"><%- item.text %></a>
    <% }) %>
  </div>
</nav>
<% } %>
