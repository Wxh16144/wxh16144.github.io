<%
  // Lite SEO <head>：字段全部可选，文章没写的回退到全局默认，仍无则不输出该标签。
  // front-matter 可用：description / summary / author / cover / robots

  const seo = theme.seo || {};

  // ---------- 公共工具 ----------
  const toText = s => String(s || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
  const absUrl = src => {
    if (!src) return '';
    if (/^https?:\/\//i.test(src)) return src;
    return config.url.replace(/\/+$/, '') + (src.charAt(0) === '/' ? '' : '/') + src;
  };
  // date 助手会套用站点 timezone，Z 输出 +08:00 偏移
  const isoOffset = d => (d ? date(d, 'YYYY-MM-DDTHH:mm:ssZ') : '');

  const isArticle = is_post();

  // ---------- <title> ----------
  const siteName = config.subtitle
    ? config.title + ' · ' + config.subtitle
    : config.title;
  const pageTitle = (page.title || '').trim();
  const headTitle = pageTitle ? pageTitle + ' | ' + config.title : siteName;

  // ---------- description：front-matter > 摘要/正文 > 站点描述，截 60 字 ----------
  let desc = toText(page.description) || toText(page.summary);
  if (!desc) desc = toText(page.excerpt);
  if (!desc && page.content) desc = toText(page.content);
  if (!desc) desc = toText(config.description);
  desc = desc.slice(0, 60);

  // ---------- author：文章 > 主题默认 > 站点全局 ----------
  const author = toText(page.author) || (seo.default_author || '').trim() || toText(config.author);

  // ---------- robots：单篇覆盖 > 全局默认 ----------
  const robots = toText(page.robots) || seo.robots_global || 'index,follow';

  // ---------- canonical ----------
  // 首页 permalink 带 index.html，规整成根路径
  let canonical = page.permalink || absUrl(url_for(page.path));
  if (canonical === config.url.replace(/\/+$/, '') + '/index.html') canonical = config.url.replace(/\/+$/, '') + '/';

  // ---------- 分享图：文章 cover > 全局默认 ----------
  const ogImg = absUrl(page.cover || seo.default_og_image || '');

  // ---------- 时间：仅文章输出 ----------
  const publishedISO = isArticle ? isoOffset(page.date) : '';
  const modifiedISO  = isArticle ? isoOffset(page.updated) : '';

  // ---------- JSON-LD：仅文章输出，列表页写了会误导爬虫 ----------
  const ld = (() => {
    if (!isArticle) return null;
    const o = {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: toText(pageTitle) || siteName,
      url: canonical,
      mainEntityOfPage: canonical,
      publisher: { '@type': 'Organization', name: config.title }
    };
    if (desc) o.description = desc;
    if (author) o.author = { '@type': 'Person', name: author };
    if (ogImg) o.image = ogImg;
    if (publishedISO) o.datePublished = publishedISO;
    if (modifiedISO) o.dateModified = modifiedISO;
    if (seo.license_url) o.license = seo.license_url;
    return o;
  })();
  // 转义 < 防正文里出现 </script> 提前闭合
  const ldJson = ld ? JSON.stringify(ld).replace(/</g, '\\u003c') : '';
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<!-- 正文里数字多，别让 iOS / 微信把它们识别成电话链接 -->
<meta name="format-detection" content="telephone=no">

<title><%= headTitle %></title>

<% if (desc) { %>
<meta name="description" content="<%= desc %>">
<% } %>

<% if (config.keywords) { %>
<meta name="keywords" content="<%= toText(config.keywords) %>">
<% } %>

<% if (author) { %>
<meta name="author" content="<%= author %>">
<% } %>

<meta name="robots" content="<%= robots %>">

<link rel="canonical" href="<%= canonical %>">

<!-- LLM 发现入口；归档/首页没有 md 路由，不输出 -->
<link rel="describedby" href="<%= absUrl('llms.txt') %>">

<!-- 订阅源自动发现 -->
<link rel="alternate" type="application/rss+xml" title="<%= config.title %>" href="<%= url_for('feed.xml') %>">
<link rel="alternate" type="application/rss+xml" title="<%= config.title %> · Notes" href="<%= url_for('notes.xml') %>">
<% if (is_post() || is_page()) { %>
<link rel="alternate" type="text/markdown" href="<%= md_url(page.path) %>">
<% } %>

<% if (seo.license_url) { %>
<link rel="license" href="<%= seo.license_url %>">
<% } %>

<link rel="icon" href="<%= url_for('favicon.ico') %>" sizes="32x32">

<!-- Open Graph -->
<meta property="og:type" content="<%= isArticle ? 'article' : 'website' %>">
<meta property="og:title" content="<%= pageTitle || siteName %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:locale" content="<%= seo.site_locale || 'zh_CN' %>">
<% if (desc) { %>
<meta property="og:description" content="<%= desc %>">
<% } %>
<% if (isArticle && publishedISO) { %>
<meta property="article:published_time" content="<%= publishedISO %>">
<% } %>
<% if (isArticle && modifiedISO) { %>
<meta property="article:modified_time" content="<%= modifiedISO %>">
<% } %>
<% if (ogImg) { %>
<meta property="og:image" content="<%= ogImg %>">
<% } %>

<!-- Twitter Card -->
<meta name="twitter:card" content="<%= ogImg ? (seo.twitter_card || 'summary') : 'summary' %>">
<meta name="twitter:title" content="<%= pageTitle || siteName %>">
<meta name="twitter:url" content="<%= canonical %>">
<% if (desc) { %>
<meta name="twitter:description" content="<%= desc %>">
<% } %>
<% if (ogImg) { %>
<meta name="twitter:image" content="<%= ogImg %>">
<% } %>

<!-- schema.org 微数据：QQ / 微博的链接卡片读这里（微信只用 meta description + 正文首图） -->
<meta itemprop="name" content="<%= pageTitle || siteName %>">
<% if (desc) { %>
<meta itemprop="description" content="<%= desc %>">
<% } %>
<% if (ogImg) { %>
<meta itemprop="image" content="<%= ogImg %>">
<% } %>

<!-- JSON-LD -->
<% if (ldJson) { %>
<script type="application/ld+json"><%- ldJson %></script>
<% } %>

<!-- 移动端地址栏配色 -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#18181b" media="(prefers-color-scheme: dark)">

<link rel="stylesheet" href="<%= url_for('css/style.css') %>">
<% if (page.content) { %>
<link rel="stylesheet" href="<%= theme.cdn.markdown_css %>">
<link rel="stylesheet" href="<%= theme.cdn.highlight_light %>" media="(prefers-color-scheme: light)">
<link rel="stylesheet" href="<%= theme.cdn.highlight_dark %>" media="(prefers-color-scheme: dark)">
<% } %>
<% [].concat(theme.cdn.font || []).forEach(function (href) { %>
<link rel="preload" as="style" crossorigin href="<%= href %>" onload="this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="<%= href %>"></noscript>
<% }) %>
<!-- 必须排在 github-markdown-css 之后 -->
<style>
  .markdown-body {
    font-family: var(--font);
  }
  .markdown-body code,
  .markdown-body tt,
  .markdown-body kbd,
  .markdown-body pre,
  .markdown-body samp {
    font-family: var(--font-code);
  }
</style>
<script src="<%= url_for('js/bundle.js') %>" defer></script>
