<%
  // ============================================================
  // Lite SEO <head> partial
  // 原则：所有字段可选 —— 文章没写的自动回退到全局默认值，
  // 找不到就干脆不输出该标签，绝不输出空属性/空 content。
  // 可用字段（front-matter）：
  //   description / summary / author / cover / robots
  // ============================================================

  const seo = theme.seo || {};

  // ---------- 公共工具 ----------
  // HTML 去标签 + 空白归一化，取纯文本
  const toText = s => String(s || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
  // 相对路径(/xxx、xxx.jpg、//cdn…) 或裸路径统一成绝对 URL
  const absUrl = src => {
    if (!src) return '';
    if (/^https?:\/\//i.test(src)) return src;
    return config.url.replace(/\/+$/, '') + (src.charAt(0) === '/' ? '' : '/') + src;
  };
  // date 助手内部会套用站点 timezone，Z 输出形如 +08:00 的偏移
  const isoOffset = d => (d ? date(d, 'YYYY-MM-DDTHH:mm:ssZ') : '');

  const isArticle = is_post();

  // ---------- <title> ----------
  const siteName = config.subtitle
    ? config.title + ' · ' + config.subtitle
    : config.title;
  const pageTitle = (page.title || '').trim();
  const headTitle = pageTitle ? pageTitle + ' | ' + config.title : siteName;

  // ---------- description（SEO 重点，全局兜底链） ----------
  // description > summary > 正文/摘要前 60 字符 > 站点描述
  let desc = toText(page.description) || toText(page.summary);
  if (!desc) desc = toText(page.excerpt);
  if (!desc && page.content) desc = toText(page.content);
  if (!desc) desc = toText(config.description);
  desc = desc.slice(0, 60);

  // ---------- author：文章 > 主题默认 > 站点全局 ----------
  const author = toText(page.author) || (seo.default_author || '').trim() || toText(config.author);

  // ---------- robots：单篇覆盖 > 全局默认 ----------
  const robots = toText(page.robots) || seo.robots_global || 'index,follow';

  // ---------- canonical：permalink 已是绝对地址，缺省时拼接 ----------
  // 首页路由生成的 permalink 会带 index.html，规整成根路径
  let canonical = page.permalink || absUrl(url_for(page.path));
  if (canonical === config.url.replace(/\/+$/, '') + '/index.html') canonical = config.url.replace(/\/+$/, '') + '/';

  // ---------- 分享图（可选；default_og_image 留空 = 不做兜底） ----------
  const ogImg = absUrl(page.cover || seo.default_og_image || '');

  // ---------- 时间（仅文章输出，ISO8601 带时区偏移） ----------
  const publishedISO = isArticle ? isoOffset(page.date) : '';
  const modifiedISO  = isArticle ? isoOffset(page.updated) : '';

  // ---------- JSON-LD：文章输出 Article；列表/单页不输出避免误导爬虫 ----------
  const ld = (() => {
    if (!isArticle) return null;
    const o = {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: toText(pageTitle) || siteName,
      url: canonical,
      mainEntityOfPage: canonical,
      publisher: { '@type': 'Organization', name: config.title }
    };
    if (desc) o.description = desc;
    if (author) o.author = { '@type': 'Person', name: author };
    if (ogImg) o.image = ogImg;
    if (publishedISO) o.datePublished = publishedISO;
    if (modifiedISO) o.dateModified = modifiedISO;
    if (seo.license_url) o.license = seo.license_url;
    return o;
  })();
  // </script> 逃逸：所有 < 转义为 \u003c（JSON 标准写法），防正文/标题里出现 </script>
  const ldJson = ld ? JSON.stringify(ld).replace(/</g, '\\u003c') : '';
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">

<title><%= headTitle %></title>

<% if (desc) { %>
<meta name="description" content="<%= desc %>">
<% } %>

<% if (author) { %>
<meta name="author" content="<%= author %>">
<% } %>

<meta name="robots" content="<%= robots %>">

<link rel="canonical" href="<%= canonical %>">

<% if (seo.license_url) { %>
<link rel="license" href="<%= seo.license_url %>">
<% } %>

<link rel="icon" href="<%= url_for('favicon.png') %>">

<!-- Open Graph -->
<meta property="og:type" content="<%= isArticle ? 'article' : 'website' %>">
<meta property="og:title" content="<%= pageTitle || siteName %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:locale" content="<%= seo.site_locale || 'zh_CN' %>">
<% if (desc) { %>
<meta property="og:description" content="<%= desc %>">
<% } %>
<% if (isArticle && publishedISO) { %>
<meta property="article:published_time" content="<%= publishedISO %>">
<% } %>
<% if (isArticle && modifiedISO) { %>
<meta property="article:modified_time" content="<%= modifiedISO %>">
<% } %>
<% if (ogImg) { %>
<meta property="og:image" content="<%= ogImg %>">
<% } %>

<!-- Twitter Card（无封面时降级为小卡 summary，不强求大图） -->
<meta name="twitter:card" content="<%= ogImg ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= pageTitle || siteName %>">
<meta name="twitter:url" content="<%= canonical %>">
<% if (desc) { %>
<meta name="twitter:description" content="<%= desc %>">
<% } %>
<% if (ogImg) { %>
<meta name="twitter:image" content="<%= ogImg %>">
<% } %>

<!-- Schema.org JSON-LD（Google 结构化数据） -->
<% if (ldJson) { %>
<script type="application/ld+json"><%- ldJson %></script>
<% } %>

<!-- 主题色（移动端地址栏） -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#18181b" media="(prefers-color-scheme: dark)">

<!-- 样式与脚本 -->
<link rel="stylesheet" href="<%= url_for('css/style.css') %>">
<% if (page.content) { %>
<link rel="stylesheet" href="<%= theme.cdn.markdown_css %>">
<link rel="stylesheet" href="<%= theme.cdn.highlight_light %>" media="(prefers-color-scheme: light)">
<link rel="stylesheet" href="<%= theme.cdn.highlight_dark %>" media="(prefers-color-scheme: dark)">
<% } %>
<script src="<%= url_for('js/bundle.js') %>" defer></script>
