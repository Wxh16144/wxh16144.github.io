<%
  // 未来日期(如 2099 的常青文章)显示时归一化为构建当天,排序仍按真实日期
  const now = new Date();
  const displayDate = (d) => {
    const dateObj = new Date(d);
    return dateObj > now ? now : dateObj;
  };

  // Group consecutive posts by year for the watermark headings below.
  // 水印同时是“该年归档”(/YYYY/) 的入口:链接必须用文章的真实年份 ——
  // hexo-generator-archive 是按真实日期建 /YYYY/ 的,而未来日期的常青文章
  // 显示成今年,所以「显示年份」和「归档年份」可能是两个值。
  const yearGroups = [];
  posts.forEach(function (post) {
    const year = date(displayDate(post.date), 'YYYY');
    const lastGroup = yearGroups[yearGroups.length - 1];
    if (!lastGroup || lastGroup.year !== year) {
      yearGroups.push({
        year: year,
        archiveYear: date(post.date, 'YYYY'),
        posts: [{ post: post, shown: displayDate(post.date) }],
      });
    } else {
      lastGroup.posts.push({ post: post, shown: displayDate(post.date) });
    }
  });
%>
<div class="home">
  <div class="post-list-wrap">
    <% yearGroups.forEach(function (group) { %>
    <div class="year-group">
      <%# 年份是装饰性文字（同组文章的日期已表达同一信息），交给 CSS ::after 绘制 %>
      <% if (String(page.year) === group.archiveYear) { %>
      <span class="year-watermark is-current" data-year="<%= group.year %>" aria-hidden="true"></span>
      <% } else { %>
      <a class="year-watermark" data-year="<%= group.year %>" href="<%= url_for('/' + group.archiveYear + '/') %>" aria-label="<%= group.year %> 年归档"></a>
      <% } %>
      <ul class="post-list">
        <% group.posts.forEach(function (item) { %>
        <li>
          <span class="post-date"><%= date(item.shown, 'MM-DD') %></span>
          <a class="post-title" href="<%= url_for(item.post.path) %>"><%= item.post.title %></a>
        </li>
        <% }) %>
      </ul>
    </div>
    <% }) %>
  </div>
  <% if (theme.bio && theme.bio.length) { %>
  <aside class="bio">
    <% if (theme.avatar) { %>
    <img class="avatar" src="<%= url_for(theme.avatar) %>" width="260" height="260" alt="<%= config.author %>" fetchpriority="high" decoding="async" onload="this.style.background='none'">
    <% } %>
    <% theme.bio.forEach(function (p) { %><p><%= p %></p><% }) %>
  </aside>
  <% } %>
</div>
