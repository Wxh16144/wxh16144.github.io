<%
  // 未来日期(如 2099 的常青文章)显示时归一化为构建当天,排序仍按真实日期
  const now = new Date();
  const displayDate = (d) => {
    const dateObj = new Date(d);
    return dateObj > now ? now : dateObj;
  };

  // 按「显示年份」分组,同一年的文章收在同一个水印下;
  // 水印同时是 /YYYY/ 归档入口 —— 归档页(scripts/archive.js)用同一套显示年份
  // 分组,所以链接直接用 group.year 即可对上。
  const yearGroups = [];
  const groupByYear = new Map();
  posts.forEach(function (post) {
    const shown = displayDate(post.date);
    const year = date(shown, 'YYYY');
    let group = groupByYear.get(year);
    if (!group) {
      groupByYear.set(year, group = { year: year, posts: [] });
      yearGroups.push(group);
    }
    group.posts.push({ post: post, shown: shown });
  });
%>
<div class="home">
  <div class="post-list-wrap">
    <% yearGroups.forEach(function (group) { %>
    <div class="year-group">
      <%# 年份是装饰性文字（同组文章的日期已表达同一信息），交给 CSS ::after 绘制 %>
      <% if (String(page.year) === group.year) { %>
      <span class="year-watermark is-current" data-year="<%= group.year %>" aria-hidden="true"></span>
      <% } else { %>
      <a class="year-watermark" data-year="<%= group.year %>" href="<%= url_for('/' + group.year + '/') %>" aria-label="<%= group.year %> 年归档"></a>
      <% } %>
      <ul class="post-list">
        <% group.posts.forEach(function (item) { %>
        <li>
          <span class="post-date"><%= date(item.shown, 'MM-DD') %></span>
          <a class="post-title" href="<%= url_for(item.post.path) %>"><%= item.post.title %></a>
        </li>
        <% }) %>
      </ul>
    </div>
    <% }) %>
  </div>
  <% if (theme.bio && theme.bio.length) { %>
  <aside class="bio">
    <% if (theme.avatar) { %>
    <img class="avatar" src="<%= url_for(theme.avatar) %>" width="260" height="260" alt="<%= config.author %>" fetchpriority="high" decoding="async" onload="this.style.background='none'">
    <% } %>
    <% theme.bio.forEach(function (p) { %><p><%= p %></p><% }) %>
  </aside>
  <% } %>
</div>
