<header class="site-header">
  <a class="site-title" href="<%= url_for('/') %>"><img class="site-logo" src="<%= url_for('images/logo.svg') %>" alt=""><%= config.title %></a>
  <nav class="site-nav">
    <% auto_nav().forEach(function (item) { %>
      <a href="<%= url_for(item.url) %>"><%= item.name %></a>
    <% }) %>
    <% const links = contact_links() %>
    <% if (links.length) { %>
    <details class="links-toggle">
      <summary>find me</summary>
      <div class="links-list">
        <span class="links-hint">$ npx wxh16144</span>
        <% links.forEach(function (item) { %>
          <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer"><%= item.name %></a>
        <% }) %>
      </div>
    </details>
    <% } %>
  </nav>
</header>
<hr class="dashed">
