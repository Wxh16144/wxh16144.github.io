<%- partial('_partial/toc') %>
<article class="post">
  <h1 class="page-title"><%= page.title %></h1>
  <div class="post-meta"><%= date(page.date, config.date_format) %></div>
  <div class="markdown-body">
    <%- page.content %>
  </div>
  <p class="post-license">
    <% const licenseUrl = theme.seo && theme.seo.license_url %>
    <% if (licenseUrl) { %>
    <a href="<%= licenseUrl %>" target="_blank" rel="noopener noreferrer"><%= theme.footer.license %></a>
    <% } else { %>
    <span><%= theme.footer.license %></span>
    <% } %>
    <%- theme.footer.since + '–PRESENT' %> © <%= config.author %>
  </p>
  <p class="post-back">
    <a href="<%= url_for('/') %>">cd ..</a>
    <a href="<%= md_url(page.path) %>">.md</a>
  </p>
</article>
<%- partial('_partial/comments') %>
